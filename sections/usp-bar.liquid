<style>
.usp.trustbar{ 
  background:#0a0a0a; 
  color:#fff; 
  padding:6px 20px; 
  border-top:1px solid rgba(255,255,255,.06); 
  overflow: hidden;
  position: relative;
  z-index: 10;
  margin: 0;
  width: 100%;
}
.usp__wrap{ 
  display:flex !important; 
  align-items:center; 
  justify-content:center; 
  gap:20px; 
  flex-wrap:wrap !important;
  max-width: 1400px;
  margin: 0 auto;
}
.usp__item{ 
  display:flex; 
  align-items:center; 
  gap:6px; 
  font-size:.875rem; 
  opacity:.86;
  flex: 0 0 auto;
  white-space: nowrap;
}
.usp__text-mobile {
  display: none;
}
.usp__text-desktop {
  display: inline;
}
@media(max-width: 749px){
  .usp.trustbar{ 
    padding:6px 10px; 
    margin: 0;
    border-radius: 0;
  }
  .usp__wrap{ 
    gap:0 !important; 
    font-size:.7rem; 
    justify-content:space-evenly !important;
    flex-wrap: nowrap !important;
    width: 100%;
  }
  .usp__item{ 
    flex: 1 1 0;
    min-width: 0;
    font-size:.7rem;
    gap: 3px;
    justify-content: center;
  }
  .usp__item span {
    white-space: nowrap;
  }
  .usp__text-mobile {
    display: inline;
  }
  .usp__text-desktop {
    display: none;
  }
}
</style>
<section class="usp trustbar" data-trust-bar>
  <div class="usp__wrap">
    <div class="usp__item">🔒 <span class="usp__text-desktop">SSL Secure Checkout</span><span class="usp__text-mobile">SSL</span></div>
    <div class="usp__item">↩️ <span class="usp__text-desktop">30-Day Returns</span><span class="usp__text-mobile">30-Day</span></div>
    <div class="usp__item">🚚 <span class="usp__text-desktop">Free Shipping $50+</span><span class="usp__text-mobile">$50+</span></div>
  </div>
</section>
{% schema %}{
  "name": "Trust bar (USPs)",
  "settings": [
    {
      "type": "header",
      "content": "Design Controls"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "pad_y",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_max",
      "min": 240,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Max image width",
      "default": 800
    },
    {
      "type": "select",
      "id": "button_align",
      "label": "Button alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [{ "name": "Trust bar (USPs)" }]
}{% endschema %}
