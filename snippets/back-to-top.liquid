<button id="backtop" aria-label="Back to top" style="position:fixed;right:var(--space-lg);bottom:var(--space-lg);z-index:60;border:1px solid #111;background:#111;color:#fff;border-radius:var(--radius-pill);width:44px;height:44px;display:none">↑</button>
<script>
(function(){
  var b=document.getElementById('backtop'); if(!b) return;
  window.addEventListener('scroll', function(){ b.style.display = (window.scrollY>600)?'block':'none'; }, {passive:true});
  b.addEventListener('click', function(){ window.scrollTo({top:0, behavior:'smooth'}); });
})();
</script>
