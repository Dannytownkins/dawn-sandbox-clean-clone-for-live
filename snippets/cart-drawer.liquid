<script>
// Force cart drawer to open from the right - AGGRESSIVE ENFORCEMENT
(function() {
  function enforceRightPositioning() {
    const drawer = document.getElementById('cart-drawer');
    if (!drawer) return;
    
    const panel = drawer.querySelector('.cart-drawer__panel');
    
    // Force drawer container to right with inline styles (highest priority)
    drawer.style.setProperty('left', 'auto', 'important');
    drawer.style.setProperty('right', '0', 'important');
    drawer.style.setProperty('width', '100vw', 'important');
    drawer.style.setProperty('margin-left', '0', 'important');
    drawer.style.setProperty('margin-right', '0', 'important');
    
    // Force panel to right
    if (panel) {
      panel.style.setProperty('left', 'auto', 'important');
      panel.style.setProperty('right', '0', 'important');
    }
  }
  
  // Apply immediately and on various events
  enforceRightPositioning();
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', enforceRightPositioning);
  }
  
  // Watch for drawer visibility changes and DOM mutations
  const observer = new MutationObserver(() => {
    enforceRightPositioning();
  });
  
  const drawer = document.getElementById('cart-drawer');
  if (drawer) {
    observer.observe(drawer, { 
      attributes: true, 
      attributeFilter: ['hidden', 'style', 'class'],
      childList: true,
      subtree: true
    });
    enforceRightPositioning();
  }
  
  // Also run on any cart drawer open events
  document.addEventListener('click', () => {
    setTimeout(enforceRightPositioning, 0);
  }, true);
  
  // Run periodically to catch any late changes
  setInterval(enforceRightPositioning, 100);
})();

// Update progress bar and cart totals
function updateCartProgress(cartData) {
  const threshold = 5000; // $50.00 in cents
  const subtotal = cartData.total_price;
  const remaining = threshold - subtotal;
  const pct = Math.min((subtotal * 100) / threshold, 100);
  
  const progressMsg = document.querySelector('#cart-drawer .cart-progress__msg');
  const progressBar = document.querySelector('#cart-drawer .cart-progress__bar span');
  
  if (progressMsg) {
    if (remaining > 0) {
      progressMsg.textContent = `Only $${(remaining / 100).toFixed(2)} away from free shipping`;
      progressMsg.classList.remove('cart-progress__msg--ok');
    } else {
      progressMsg.textContent = "You're eligible for free shipping!";
      progressMsg.classList.add('cart-progress__msg--ok');
    }
  }
  
  if (progressBar) {
    progressBar.style.width = `${pct}%`;
  }
  
  // Update subtotal
  const subtotalEl = document.querySelector('#cart-drawer .cart-subtotal__amount');
  if (subtotalEl) {
    subtotalEl.textContent = `$${(subtotal / 100).toFixed(2)}`;
  }
}

// Refresh cart drawer content
async function refreshCartDrawer() {
  try {
    const response = await fetch(window.location.pathname + '?sections=cart-drawer');
    if (response.ok) {
      const data = await response.json();
      const html = data['cart-drawer'];
      if (html) {
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = html;
        const newDrawerContent = tempDiv.querySelector('#cart-drawer');
        const currentDrawer = document.querySelector('#cart-drawer');
        if (newDrawerContent && currentDrawer) {
          const wasOpen = !currentDrawer.hasAttribute('hidden');
          currentDrawer.replaceWith(newDrawerContent);
          // Keep drawer open if it was open
          if (wasOpen) {
            newDrawerContent.removeAttribute('hidden');
            newDrawerContent.setAttribute('aria-hidden', 'false');
          }
        }
      }
      
      // Update header cart badge count
      const cartResponse = await fetch('/cart.js');
      if (cartResponse.ok) {
        const cart = await cartResponse.json();
        const badges = document.querySelectorAll('.cart-count-bubble span[aria-hidden="true"]');
        badges.forEach(badge => {
          badge.textContent = cart.item_count;
        });
      }
    }
  } catch(err) {
    console.error('Cart refresh failed:', err);
  }
}

// Quantity and remove handling WITHOUT page reload
document.addEventListener('click', async (e) => {
  const btn = e.target.closest('.qty__btn');
  const removeBtn = e.target.closest('.cart-drawer__remove');
  
  if (btn) {
    e.preventDefault();
    e.stopPropagation();
    const line = Number(btn.dataset.line);
    const delta = btn.dataset.qty === '+1' ? 1 : -1;
    const input = btn.parentElement.querySelector('.qty__input');
    const currentQty = parseInt(input.value || '1', 10);
    const next = Math.max(0, currentQty + delta);

    try {
      const response = await fetch('{{ routes.cart_change_url }}', {
        method: 'POST',
        headers: { 'Content-Type':'application/json', 'Accept':'application/json' },
        body: JSON.stringify({ line, quantity: next })
      });
      
      if (response.ok) {
        const cartData = await response.json();
        // Update progress bar immediately
        updateCartProgress(cartData);
        // Refresh drawer content
        await refreshCartDrawer();
      }
    } catch(err) {
      console.error('Cart update failed:', err);
    }
  }
  
  if (removeBtn) {
    e.preventDefault();
    e.stopPropagation();
    const url = removeBtn.getAttribute('href');
    try {
      const response = await fetch(url, { method: 'POST' });
      if (response.ok) {
        // Refresh drawer content
        await refreshCartDrawer();
      }
    } catch(err) {
      console.error('Remove failed:', err);
    }
  }
});
</script>
