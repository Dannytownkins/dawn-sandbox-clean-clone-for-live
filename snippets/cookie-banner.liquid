<div id="cookie-bar" class="cookie-bar" aria-hidden="true">
  <div class="inner">
    <p>We use cookies to personalize and improve your experience. See our <a href="/policies/privacy-policy">Privacy Policy</a>.</p>
    <div class="actions">
      <button type="button" class="btn accept">Accept</button>
      <a class="link" href="/policies/privacy-policy">Learn more</a>
    </div>
  </div>
</div>
<style>
.cookie-bar[aria-hidden="true"] { display: none; }
.cookie-bar {
  position: fixed;
  left: var(--space-lg);
  right: var(--space-lg);
  bottom: var(--space-lg);
  z-index: 90;
  background: #111;
  color: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
}
.cookie-bar .inner {
  display: flex;
  gap: var(--space-md);
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) var(--space-lg);
}
.cookie-bar a { color: var(--brand-yellow); }
.cookie-bar .btn {
  background: var(--brand-yellow);
  color: #111;
  border: 1px solid var(--brand-yellow);
  border-radius: var(--radius-md);
  min-height: 40px;
  padding: 0 var(--space-md);
  font-weight: 700;
}
.cookie-bar .actions {
  display: flex;
  gap: var(--space-sm);
  align-items: center;
}
@media (max-width: 640px) {
  .cookie-bar .inner {
    flex-direction: column;
    align-items: flex-start;
  }
  .cookie-bar {
    left: var(--space-sm);
    right: var(--space-sm);
  }
}
</style>
<script>
(function(){
  var KEY='cookie_ok_v1_until';
  function seen(){ var v=localStorage.getItem(KEY); return v && Date.now()<parseInt(v,10); }
  function set(days){ localStorage.setItem(KEY, String(Date.now()+days*24*3600*1000)); }
  function show(){ bar.setAttribute('aria-hidden','false'); }
  function hide(){ bar.setAttribute('aria-hidden','true'); }
  var bar=document.getElementById('cookie-bar'); if(!bar) return;
  if(!seen()) show();
  bar.querySelector('.accept').addEventListener('click', function(){ set(180); hide(); });
})();
</script>
